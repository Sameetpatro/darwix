# ==========================================
# Voice Agent Environment Configuration Template
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Configuration (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_FALLBACK_ON_ERROR=true

# Text-To-Speech (TTS) Configuration
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-EmmaMultilingualNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Speech-To-Text (ASR) Configuration
ASR_PROVIDER=web-speech
ASR_LANGUAGE=en-US

# Recording & Retention Settings
SAVE_AUDIO_RECORDINGS=true
SAVE_TRANSCRIPTS=true
RECORDINGS_DIR=recordings
TRANSCRIPTS_DIR=transcripts
LOGS_DIR=logs

# ==========================================
# Q2 Knowledge Ingestion & RAG Settings
# ==========================================
# Laya / Decision Model (Replaces Jev)
LAYA_API_KEY=your_laya_api_key_here
LAYA_BASE_URL=https://api.laya.studio/v1
LAYA_MODEL=systemone

# OpenAI (Embeddings & LLM fallback)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL Database (e.g. Neon DB / PostgreSQL with pgvector)
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require
